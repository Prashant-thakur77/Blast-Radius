# Optional. OpenAI key for the legacy enrichment, embeddings and chat endpoints.
# The review engine, CLI and MCP server do not need it.
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Shared secret protecting mutating API endpoints
# Used by: frontend (stored in browser localStorage) and CI
# Protected: POST /api/repos, /ingest, /enrich, /sync, /analyze-mr, DELETE /reset
# If empty, all endpoints are open (useful for local dev)
BLASTRADIUS_API_SECRET=

# Frontend URL for generating links in API responses (sync, analyze-mr)
# Used by: sync endpoint (returns graph URL), analyze-mr (returns impact view URL)
# Default: http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Environment
ENV=dev

# Data storage paths (defaults work for local dev)
# DATA_DIR=./data
# REPOS_DIR=./data/repos
# DB_PATH=./blastradius.db

# Optional. IBM watsonx.ai (Granite) for review summaries. Region must be Dallas.
WATSONX_APIKEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL=ibm/granite-4-h-small
